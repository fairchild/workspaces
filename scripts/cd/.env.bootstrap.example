# Copy to .env.bootstrap (gitignored via .env.*) and fill in.
# Then: `uv run scripts/cd/bootstrap-preview.py` for a dry-run preview,
#       `uv run scripts/cd/bootstrap-preview.py --apply` to actually write.

# --- GitHub Actions secrets (pushed via `gh secret set`) ---
# Vercel → https://vercel.com/account/tokens
VERCEL_TOKEN=

# Cloudflare → dashboard → My Profile → API Tokens (Edit Workers template + R2 Storage:Edit)
CLOUDFLARE_API_TOKEN=
# Cloudflare dashboard sidebar on any account page, or `wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# --- Cloudflare Worker preview secrets ---
# Naming convention: PW_<SECRET_NAME>. The script reads these and runs
# `wrangler secret put <SECRET_NAME> --env preview` for each.
# Each value should be the PREVIEW value, distinct from prod when sensible.

# webhook-relay preview
PW_GITHUB_WEBHOOK_SECRET=
PW_JWT_SIGNING_SECRET=

# evidence-store preview
PW_EVIDENCE_UPLOAD_TOKEN=
