#!/bin/bash
# ============================================================================
# signing-config.sh - Code Signing Configuration for WorkspaceManager
# ============================================================================
#
# This file contains your personal signing credentials. To use:
#
# 1. Copy this file to signing-config.sh:
#    cp signing-config.sh.template signing-config.sh
#
# 2. Fill in your Apple Developer credentials below
#
# 3. NEVER commit signing-config.sh to version control (it's gitignored)
#
# Prerequisites:
# - Apple Developer Program membership ($99/year)
# - Developer ID Application certificate installed in Keychain
# - App Store Connect API key with notarization access
#
# ============================================================================

# Your 10-character Apple Developer Team ID
# Find it at: https://developer.apple.com/account -> Membership Details
export TEAM_ID="XXXXXXXXXX"

# The app's bundle identifier (don't change unless you know what you're doing)
export BUNDLE_ID="com.cloudcompute.workspaces"

# Signing identity (typically matches your certificate name)
# Format: "Developer ID Application: Your Name (TEAM_ID)"
# List available identities: security find-identity -v -p codesigning
export SIGNING_IDENTITY="Developer ID Application: Your Name ($TEAM_ID)"

# Developer ID provisioning profile with keychain sharing enabled for
# com.cloudcompute.workspaces. Signed packaged apps need this in addition to the
# certificate so they can claim the data protection keychain access group.
export PROVISIONING_PROFILE_PATH="$HOME/.config/apple/workspaces.provisionprofile"

# App Store Connect API key for notarization.
# Create this in App Store Connect > Users and Access > Integrations > App Store Connect API.
# Store the downloaded .p8 file outside the repository.
export APPLE_API_KEY_PATH="$HOME/.config/apple/AuthKey_XXXXXXXXXX.p8"
export APPLE_API_KEY_ID="XXXXXXXXXX"
export APPLE_API_ISSUER_ID="00000000-0000-0000-0000-000000000000"

# ============================================================================
# Verification Commands
# ============================================================================
# After signing, verify with these commands:
#
# Check code signature:
#   codesign -dv --verbose=4 path/to/WorkSpaces.app
#
# Verify Gatekeeper approval:
#   spctl --assess --type execute --verbose path/to/WorkSpaces.app
#
# Check notarization status:
#   xcrun stapler validate path/to/WorkSpaces.dmg
#
# ============================================================================
