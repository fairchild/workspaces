{
	"name": "spaces-next",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3100",
		"build": "NODE_ENV=production next build",
		"start": "next start --port 3100",
		"e2e:server": "rm -f .data/e2e.db* && { test -f .next/BUILD_ID || NODE_ENV=production next build; } && AUTH_BYPASS=1 ALLOWED_LOGINS=fairchild SESSIONS_DATABASE_URL=file:.data/e2e.db next start --port 3100",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"evidence": "node scripts/evidence.mjs",
		"perf": "node perf/run.mjs",
		"validate": "node scripts/validate.mjs"
	},
	"dependencies": {
		"@ai-sdk/harness": "1.0.18",
		"@ai-sdk/harness-claude-code": "1.0.18",
		"@ai-sdk/react": "^4.0.15",
		"@ai-sdk/sandbox-vercel": "1.0.18",
		"@libsql/client": "^0.17.4",
		"@radix-ui/react-collapsible": "^1.1.15",
		"@radix-ui/react-use-controllable-state": "^1.2.3",
		"@vercel/sandbox": "2.4.0",
		"ai": "7.0.15",
		"better-auth": "1.6.20",
		"kysely": "^0.28.17",
		"next": "^15.5.19",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"ws": "^8.21.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9.39.4",
		"eslint-config-next": "^15.5.20",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.22.5",
		"typescript": "^5.7.2",
		"vitest": "^4.1.9"
	}
}
