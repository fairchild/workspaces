#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! command -v swift-format >/dev/null 2>&1; then
    echo "[pre-commit] ERROR: swift-format not found in PATH" >&2
    echo "[pre-commit] Install it and retry commit." >&2
    exit 1
fi

echo "[pre-commit] Running swift-format lint..."
swift-format lint --strict --recursive Sources/ Tests/

# Lint staged web files with biome (if any ts/tsx/css/json files changed)
STAGED_WEB=$(git diff --cached --name-only --diff-filter=ACMR -- 'web/*.ts' 'web/*.tsx' 'web/*.css' 'web/*.json' 'web/**/*.ts' 'web/**/*.tsx' 'web/**/*.css' 'web/**/*.json' 2>/dev/null || true)
if [ -n "$STAGED_WEB" ]; then
    echo "[pre-commit] Running biome lint on web/..."
    pnpm --dir web lint
fi
