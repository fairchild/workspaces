{
	"name": "spaces-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.18.3",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:fast": "playwright test --project fast",
		"test:e2e:full": "playwright test --project full",
		"lhci": "lhci autorun --config=./lighthouserc.json --collect.url=$LHCI_COLLECT_URL"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.91.1",
		"@chat-adapter/github": "^4.23.0",
		"@chat-adapter/slack": "^4.23.0",
		"@chat-adapter/state-memory": "^4.23.0",
		"@libsql/client": "^0.17.2",
		"@vercel/analytics": "^2.0.1",
		"@vercel/sandbox": "^1.9.0",
		"better-auth": "^1.5.6",
		"chat": "^4.23.0",
		"ghostty-web": "^0.4.0",
		"kysely": "^0.28.14",
		"ms": "^2.1.3",
		"next": "^15.5.15",
		"posthog-js": "^1.367.0",
		"react": "^19",
		"react-dom": "^19"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["better-sqlite3"],
		"overrides": {
			"axios": "1.15.2",
			"defu": "6.1.5",
			"dompurify": "3.4.0",
			"follow-redirects": "1.16.0",
			"postcss": "8.5.10",
			"protobufjs": "7.5.5",
			"vite": "8.0.5"
		}
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.2",
		"@biomejs/biome": "^1",
		"@lhci/cli": "^0.14.0",
		"@playwright/test": "^1.58.2",
		"@types/ms": "^2.1.0",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"typescript": "^5",
		"vite": "8.0.5",
		"vitest": "^4.1.5"
	}
}
