{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": { "recommended": true }
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"css": {
		"parser": { "cssModules": true }
	},
	"files": {
		"ignore": [
			".next/",
			".claude/",
			".vercel/",
			"node_modules/",
			"e2e/",
			"playwright-report/",
			"test-results/"
		]
	}
}
